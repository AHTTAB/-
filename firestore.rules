rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function existsUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return existsUser() && getUserData().role == role;
    }

    function isAmin() {
      return isAuthenticated() && (
        request.auth.token.email == "amriahassan@gmail.com" ||
        (existsUser() && getUserData().role == 'amin')
      );
    }

    function isStaff() {
      return isAuthenticated();
    }

    // ===============================================================
    // Data Validators
    // ===============================================================
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             (!('role' in data) || data.role in ['mukallaf', 'amin', 'rais']) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('allowedTabs' in data) || data.allowedTabs is list) &&
             (!('signatureUrl' in data) || data.signatureUrl is string) &&
             (!('balance' in data) || data.balance is number);
    }

    function isValidSubscriber(data) {
      return data.name is string && data.name.size() > 0 &&
             (!('phone' in data) || data.phone is string) &&
             (!('nationalId' in data) || data.nationalId is string) &&
             (!('subscriptionDate' in data) || data.subscriptionDate is string) &&
             (!('subscriptionFeePaid' in data) || data.subscriptionFeePaid is number) &&
             (!('balance' in data) || data.balance is number) &&
             (!('receiptNumber' in data) || data.receiptNumber is string) &&
             (!('createdBy' in data) || data.createdBy is string);
    }

    function isValidSession(data) {
      return data.subscriberId is string &&
             data.hours is number &&
             (!('rate' in data) || data.rate is number) &&
             data.totalAmount is number &&
             (!('workerWage' in data) || data.workerWage is number) &&
             (!('workerWagePaid' in data) || data.workerWagePaid is bool) &&
             (!('date' in data) || data.date is string) &&
             data.status in ['paid', 'cancelled'] &&
             (!('collectedBy' in data) || data.collectedBy is string) &&
             (!('createdBy' in data) || data.createdBy is string);
    }

    function isValidExpense(data) {
      return data.description is string &&
             data.amount is number &&
             (!('date' in data) || data.date is string) &&
             (!('createdBy' in data) || data.createdBy is string);
    }

    function isValidTransfer(data) {
      return data.fromUid is string &&
             data.toUid is string &&
             data.amount is number &&
             (!('date' in data) || data.date is string) &&
             (!('createdBy' in data) || data.createdBy is string);
    }

    // ===============================================================
    // Match Rules
    // ===============================================================
    match /settings/{id} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAmin()) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == uid || isAmin()) && isValidUser(request.resource.data);
    }

    match /subscribers/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff() && isValidSubscriber(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /sessions/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff() && isValidSession(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /expenses/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff() && isValidExpense(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /transfers/{id} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && isValidTransfer(request.resource.data);
      allow update, delete: if isAuthenticated();
    }

    match /otherIncomes/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAuthenticated();
    }
  }
}
